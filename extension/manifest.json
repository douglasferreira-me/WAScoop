{
  "manifest_version": 2,
  "name": "Whatsapp Scoop",
  "version": "0.4.3",
  "description": "Exporte o histórico acessível de grupos e canais para pesquisa: planilhas XLSX, CSV, mídias e ZIP.",
  "author": "douglasferreira",
  "homepage_url": "https://douglasferreira.me",
  "browser_specific_settings": {
    "gecko": {
      "id": "whatsapp-scoop@douglasferreira.me",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "personalCommunications",
          "personallyIdentifyingInfo",
          "websiteContent",
          "authenticationInfo"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "downloads",
    "unlimitedStorage",
    "identity",
    "https://web.whatsapp.com/*",
    "scripting",
    "alarms"
  ],
  "optional_permissions": [
    "https://accounts.google.com/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "background": {
    "page": "background.html",
    "persistent": true
  },
  "browser_action": {
    "default_title": "Abrir Whatsapp Scoop",
    "default_icon": {
      "16": "icons/scoop-16.png",
      "32": "icons/scoop-32.png",
      "48": "icons/scoop-48.png"
    }
  },
  "sidebar_action": {
    "default_title": "Whatsapp Scoop",
    "default_panel": "panel.html",
    "default_icon": {
      "16": "icons/scoop-16.png",
      "32": "icons/scoop-32.png",
      "48": "icons/scoop-48.png"
    }
  },
  "icons": {
    "48": "icons/scoop-48.png",
    "96": "icons/scoop-96.png",
    "128": "icons/scoop-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "lib/core.js",
        "content/adapters.js",
        "content/collector.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": "script-src 'self'; object-src 'none'"
}
